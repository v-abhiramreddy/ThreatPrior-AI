# ThreatPrior AI — Environment Configuration Template
# Copy this file to backend/.env (or .env) and set your values.
# NEVER commit your real .env file or real credentials to source control.

# -----------------------------------------------------------------------------
# NIST National Vulnerability Database (NVD) Settings
# -----------------------------------------------------------------------------
# Optional: NVD API Key increases rolling rate limit from 5 to 50 req / 30s.
# Request an official API key at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=your_nvd_api_key_here

# Timeouts in seconds
NVD_TIMEOUT_SECONDS=10.0
CISA_TIMEOUT_SECONDS=15.0
EPSS_TIMEOUT_SECONDS=6.0

# Upstream Service Endpoints
NVD_API_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
EPSS_API_URL=https://api.first.org/data/v1/epss

# In-memory Caching and Retries
CISA_CACHE_TTL_HOURS=4
MAX_RETRIES=2
RETRY_BACKOFF_FACTOR=1.5

# -----------------------------------------------------------------------------
# Strands Decider 2B System-1 Engine Configuration
# -----------------------------------------------------------------------------
# Execution mode:
# - 'local': In-process PyTorch inference via load_engine()
# - 'remote': Calls remote HTTP server via POST /v1/systemone (STRANDS_DECIDER_URL)
# - 'auto': Attempts remote HTTP server first; falls back to local or baseline
STRANDS_DECIDER_MODE=local
STRANDS_DECIDER_DEVICE=cpu
STRANDS_DECIDER_MODEL_ID=strands-decider-2b
STRANDS_DECIDER_URL=http://127.0.0.1:8080
STRANDS_DECIDER_TIMEOUT_SECONDS=30.0

# -----------------------------------------------------------------------------
# Amazon Bedrock Stage 2 Rationale Synthesis Configuration
# -----------------------------------------------------------------------------
# AWS credentials should be provided via standard AWS credential provider chain:
# (AWS_ACCESS_KEY_ID & AWS_SECRET_ACCESS_KEY env vars, ~/.aws/credentials, or IAM Role)
# Region options: us-east-1, ap-southeast-2 (Sydney)
AWS_REGION=us-east-1
# Supported Bedrock models for Stage 2 rationale synthesis:
# - Amazon Nova Lite (default): amazon.nova-lite-v1:0
# - Anthropic Claude Sonnet 4.6 (US): us.anthropic.claude-sonnet-4-6 (or anthropic.claude-sonnet-4-6)
# - Anthropic Claude Sonnet 4.6 (Sydney): au.anthropic.claude-sonnet-4-6
# - Anthropic Claude Opus 4.6: anthropic.claude-opus-4-6 (or us.anthropic.claude-opus-4-6)
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
DECISION_TIMEOUT_SECONDS=30.0
MAX_DECISION_RETRIES=2

# Fallback Policy:
# When true, gracefully falls back to deterministic policy baseline if AI engines are unavailable.
ALLOW_BASELINE_FALLBACK=true

# -----------------------------------------------------------------------------
# Frontend API Client Configuration (Optional)
# -----------------------------------------------------------------------------
# Leave empty or unset for single-service deployments (Render) where FastAPI
# serves both the built React SPA and /api routes from the same origin.
# For separate multi-origin hosting (e.g. Vercel frontend + Render backend), set to:
# VITE_API_BASE_URL=https://threatprior-ai.onrender.com
VITE_API_BASE_URL=

